# AI Gateway — variáveis de ambiente
# NUNCA commitar .env com valores reais
# cp .env.example .env && editar

# ── Provedores de IA ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ── LiteLLM ───────────────────────────────────────────────────────────────────
# Chave mestra — usada para criar virtual keys das squads via API admin
# Gerar: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-...

# ── Banco de dados ────────────────────────────────────────────────────────────
# Gerar: openssl rand -hex 16
POSTGRES_PASSWORD=...

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
# Gerar: openssl rand -hex 12
GRAFANA_PASSWORD=...

# ── Keycloak (Identity Provider) ─────────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=...
# Gerar: openssl rand -hex 16
KEYCLOAK_DB_PASSWORD=...

# ── Modelo local (opcional) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
